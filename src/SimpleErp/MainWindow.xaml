<Window x:Class="SimpleErp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SimpleErp.Core.ViewModels;assembly=SimpleErp.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Simple ERP"
        Width="1380"
        Height="860"
        MinWidth="1120"
        MinHeight="660"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.InputBindings>
    <KeyBinding Command="{Binding NewItemCommand}" Gesture="Ctrl+N" />
    <KeyBinding Command="{Binding SaveItemCommand}" Gesture="Ctrl+S" />
  </Window.InputBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================== Sidebar ============================== -->
    <Border Background="{StaticResource SidebarBrush}">
      <DockPanel Margin="14,20,14,16">

        <!-- Brand -->
        <StackPanel Margin="6,0,0,28" DockPanel.Dock="Top" Orientation="Horizontal">
          <!-- Logo: three rising bars -->
          <Border Width="38" Height="38" Background="{StaticResource AccentGradientBrush}" CornerRadius="10">
            <StackPanel Margin="0,0,0,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal">
              <Border Width="5.5" Height="9" Margin="0,0,2.5,0" VerticalAlignment="Bottom" Background="#E6FFFFFF" CornerRadius="2" />
              <Border Width="5.5" Height="14" Margin="0,0,2.5,0" VerticalAlignment="Bottom" Background="#E6FFFFFF" CornerRadius="2" />
              <Border Width="5.5" Height="20" VerticalAlignment="Bottom" Background="White" CornerRadius="2" />
            </StackPanel>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="White" Text="Simple ERP" />
            <TextBlock FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="People · Projects · KPI" />
          </StackPanel>
        </StackPanel>

        <!-- Data file, pinned to the bottom -->
        <Border Padding="12,10"
                Background="{StaticResource SidebarHoverBrush}"
                CornerRadius="8"
                DockPanel.Dock="Bottom">
          <StackPanel>
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}" Text="Saved automatically" />
            <TextBlock Margin="0,3,0,0"
                       FontSize="11"
                       Foreground="{StaticResource SidebarMutedBrush}"
                       Text="{Binding DataLocation}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DataLocation}" />
            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="Ctrl+N new  ·  Ctrl+S save" />
          </StackPanel>
        </Border>

        <!-- Navigation -->
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource SidebarHeader}" Text="WORKSPACE" />
          <ListBox ItemContainerStyle="{StaticResource NavItem}"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem}"
                   Style="{StaticResource NavList}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NavigationItem}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Path Data="{Binding IconKey, Converter={StaticResource ResourceLookup}}" Style="{StaticResource Icon}" />
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Title}" />
                  <Border Grid.Column="2"
                          MinWidth="24"
                          Padding="7,1"
                          VerticalAlignment="Center"
                          Background="#24FFFFFF"
                          CornerRadius="9"
                          Visibility="{Binding Badge, Converter={StaticResource VisibleWhen}}">
                    <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding Badge}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================== Content ============================== -->
    <DockPanel Grid.Column="1">

      <!-- Page header -->
      <Border Padding="28,16"
              Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,0,0,1"
              DockPanel.Dock="Top">
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="{Binding CurrentPage.Title}" />
          <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}" Text="{Binding CurrentPage.Subtitle}" />
        </StackPanel>
      </Border>

      <!-- Status bar -->
      <Border Padding="28,6"
              Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource DividerBrush}"
              BorderThickness="0,1,0,0"
              DockPanel.Dock="Bottom">
        <TextBlock Style="{StaticResource MutedText}" Text="{Binding Status.Message}" />
      </Border>

      <!-- The current page. WPF finds its view through the DataTemplates in Views/ViewTemplates.xaml. -->
      <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
    </DockPanel>
  </Grid>
</Window>
