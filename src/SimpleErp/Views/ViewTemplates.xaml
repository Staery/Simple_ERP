<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SimpleErp.Views"
                    xmlns:vm="clr-namespace:SimpleErp.Core.ViewModels;assembly=SimpleErp.Core">

  <!-- View-model-first navigation: when the shell shows a page view model, WPF picks the
       DataTemplate whose DataType matches and creates the view. -->

  <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
    <views:DashboardView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
    <views:EmployeesView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
    <views:ProjectsView />
  </DataTemplate>

  <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
    <views:ReportsView />
  </DataTemplate>

</ResourceDictionary>
