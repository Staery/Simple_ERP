<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SimpleErp</RootNamespace>
    <AssemblyName>SimpleERP</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Simple ERP — employees, projects and KPI</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleErp.Core\SimpleErp.Core.csproj" />
  </ItemGroup>

</Project>
